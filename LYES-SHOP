              <div><strong>Email</strong><a href="mailto:support@lyesshop.com">support@lyesshop.com</a></div>
              <div><strong>Phone</strong><a href="tel:+1234567890">+1 (234) 567-890</a></div>
              <div><strong>Follow</strong><div class="social-links"><a class="social-link" href="#">F</a><a class="social-link" href="#">I</a><a class="social-link" href="#">T</a></div></div>
            </div>
          </div>
        </div>
      </section>
      <section id="checkoutPage" class="hidden">
