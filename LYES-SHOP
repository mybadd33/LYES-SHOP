  <script>
    const STORAGE_KEYS = {
      products: 'lyes-shop-products',
      settings: 'lyes-shop-settings',
      orders: 'lyes-shop-orders',
      cart: 'lyes-shop-cart',
      admin: 'lyes-shop-admin',
      theme: 'lyes-shop-theme'
    };
    const defaultSettings = {
      siteName: 'LYES SHOP',
      logoText: 'LYES SHOP',
      primaryColor: '#1f3d8f',
      secondaryColor: '#2d9cdb',
      heroBanner: 'Discover premium products in an elegant shopping destination.',
      contactEmail: 'support@lyesshop.com',
      contactPhone: '+1 (234) 567-890',
      social: { facebook: '#', instagram: '#', twitter: '#' },
      banners: [
        { title: 'Seasonal promotions', description: 'Refresh your cart with premium items.', badge: 'New' },
        { title: 'Fast delivery', description: 'Reliable shipping for every order.', badge: 'Top seller' }
      ]
    };
    const defaultProducts = [
      { id: 'p1', title: 'Modern Leather Backpack', category: 'Accessories', price: 129, description: 'Premium leather backpack for every day.', stock: 15, image: 'https://images.unsplash.com/photo-1512436991641-6745cdb1723f?auto=format&fit=crop&w=900&q=80', rating: 4.7, new: true, bestSeller: true },
      { id: 'p2', title: 'Wireless Noise-Canceling Headphones', category: 'Electronics', price: 219, description: 'Immerse yourself in crisp, powerful sound.', stock: 22, image: 'https://images.unsplash.com/photo-1518449032870-a4c930b7708f?auto=format&fit=crop&w=900&q=80', rating: 4.9, new: true, bestSeller: true },
      { id: 'p3', title: 'Sleek Smartwatch', category: 'Wearables', price: 179, description: 'Track health and notifications with style.', stock: 10, image: 'https://images.unsplash.com/photo-1516574187841-cb9cc2ca948b?auto=format&fit=crop&w=900&q=80', rating: 4.6, new: false, bestSeller: true },
      { id: 'p4', title: 'Designer Sunglasses', category: 'Accessories', price: 89, description: 'Stylish protection for sunny days.', stock: 30, image: 'https://images.unsplash.com/photo-1526170375885-4d8ecf77b99f?auto=format&fit=crop&w=900&q=80', rating: 4.8, new: true, bestSeller: false },
      { id: 'p5', title: 'Premium Office Chair', category: 'Furniture', price: 339, description: 'Comfortable support for long working hours.', stock: 8, image: 'https://images.unsplash.com/photo-1519710164239-da123dc03ef4?auto=format&fit=crop&w=900&q=80', rating: 4.5, new: false, bestSeller: true },
      { id: 'p6', title: 'Compact Bluetooth Speaker', category: 'Electronics', price: 69, description: 'Rich sound in a pocket-ready design.', stock: 18, image: 'https://images.unsplash.com/photo-1512466413671-72f1a76564cc?auto=format&fit=crop&w=900&q=80', rating: 4.7, new: true, bestSeller: false }
    ];
    let appState = {
      products: [],
      settings: {},
      orders: [],
      cart: {},
      adminLoggedIn: false,
      activeAdminTab: 'products'
    };
    const passwordHash = 'LYES2026';
    const sectionIds = ['home', 'shop', 'categories', 'contact', 'checkout', 'admin', 'instructions'];
    function showToast(message) {
      const toast = document.getElementById('toast');
      toast.textContent = message;
      toast.classList.add('show');
      setTimeout(() => toast.classList.remove('show'), 3000);
    }
    function navigate(section) {
      sectionIds.forEach(id => document.getElementById(id + 'Page').classList.add('hidden'));
      document.getElementById(section + 'Page').classList.remove('hidden');
      document.querySelectorAll('.nav-link').forEach(link => link.classList.remove('active'));
      const navMap = {home:'Explore store', shop:'Products', categories:'Categories', contact:'Contact', admin:'Admin login'};
      document.querySelectorAll('.nav-link').forEach(link => { if(link.textContent.trim() === navMap[section]) link.classList.add('active'); });
      if (section === 'admin') renderAdmin();
    }
    function loadLocalData() {
      const savedProducts = JSON.parse(localStorage.getItem(STORAGE_KEYS.products) || 'null');
      const savedSettings = JSON.parse(localStorage.getItem(STORAGE_KEYS.settings) || 'null');
      const savedOrders = JSON.parse(localStorage.getItem(STORAGE_KEYS.orders) || 'null');
      const savedCart = JSON.parse(localStorage.getItem(STORAGE_KEYS.cart) || '{}');
      appState.products = savedProducts && savedProducts.length ? savedProducts : defaultProducts;
      appState.settings = savedSettings || defaultSettings;
      appState.orders = savedOrders || [];
      appState.cart = savedCart;
      appState.adminLoggedIn = localStorage.getItem(STORAGE_KEYS.admin) === 'true';
      const theme = localStorage.getItem(STORAGE_KEYS.theme) || 'light';
      document.documentElement.classList.toggle('dark', theme === 'dark');
      document.getElementById('themeToggle').textContent = theme === 'dark' ? 'Light mode' : 'Dark mode';
    }
    function saveLocalData() {
      localStorage.setItem(STORAGE_KEYS.products, JSON.stringify(appState.products));
      localStorage.setItem(STORAGE_KEYS.settings, JSON.stringify(appState.settings));
      localStorage.setItem(STORAGE_KEYS.orders, JSON.stringify(appState.orders));
      localStorage.setItem(STORAGE_KEYS.cart, JSON.stringify(appState.cart));
    }
    function renderProducts() {
      const query = document.getElementById('searchInput').value.toLowerCase();
      const filtered = appState.products.filter(product => product.title.toLowerCase().includes(query) || product.category.toLowerCase().includes(query));
      const container = document.getElementById('productsGrid');
      container.innerHTML = filtered.map(productCardTemplate).join('');
      document.getElementById('productList').innerHTML = appState.products.map(productCardTemplate).join('');
      document.getElementById('bestSellersGrid').innerHTML = appState.products.filter(item => item.bestSeller).map(productCardTemplate).join('');
      document.getElementById('categoryGrid').innerHTML = uniqueCategories().map(categoryCardTemplate).join('');
      document.getElementById('categoryList').innerHTML = uniqueCategories().map(categoryCardTemplate).join('');
      updateCartPanel();
    }
    function productCardTemplate(product) {
      return `<div class="product-card">
        <img src="${product.image}" alt="${product.title}" />
        <div class="category-pill">${product.category}</div>
        <h3>${product.title}</h3>
        <p>${product.description}</p>
        <div class="product-price"><strong>$${product.price.toFixed(2)}</strong><span class="rating">★ ${product.rating}</span></div>
        <div class="product-actions" style="margin-top:14px;"><button class="button" onclick="addToCart('${product.id}')">Add to cart</button><button class="button" style="background:#64748b" onclick="viewProduct('${product.id}')">View</button></div>
      </div>`;
    }
    function uniqueCategories() {
      return [...new Set(appState.products.map(item => item.category))].map(category => ({ category }));
    }
    function categoryCardTemplate(item) {
      return `<div class="category-card"><div><h3>${item.category}</h3><p>Explore premium products and curated selections in this category.</p></div><button class="button" onclick="filterCategory('${item.category}')">Browse</button></div>`;
    }
    function filterCategory(category) {
      document.getElementById('searchInput').value = category;
      renderProducts();
      navigate('shop');
      showToast(`Filtering by ${category}`);
    }
    function addToCart(productId) {
      appState.cart[productId] = (appState.cart[productId] || 0) + 1;
      saveLocalData();
      updateCartPanel();
      showToast('Product added to cart');
    }
    function updateCartPanel() {
      const cartList = document.getElementById('cartList');
      const cartItems = Object.keys(appState.cart).map(id => {
        const product = appState.products.find(item => item.id === id);
        return { product, qty: appState.cart[id] };
      });
      let total = 0;
      cartList.innerHTML = cartItems.length ? cartItems.map(item => {
        const itemTotal = item.product.price * item.qty;
        total += itemTotal;
        return `<div class="cart-item"><img src="${item.product.image}" alt="${item.product.title}" /><div class="cart-item-details"><strong>${item.product.title}</strong><span>${item.qty} × $${item.product.price.toFixed(2)}</span><button onclick="removeCartItem('${item.product.id}')">Remove</button></div></div>`;
      }).join('') : '<p style="color:var(--muted)">Your cart is empty. Start shopping now.</p>';
      document.getElementById('cartTotal').textContent = `Total: $${total.toFixed(2)}`;
      document.getElementById('checkoutSummary').innerHTML = cartItems.length ? cartItems.map(item => `<div style="display:flex;justify-content:space-between;padding:8px 0;"><span>${item.product.title} x${item.qty}</span><strong>$${(item.product.price * item.qty).toFixed(2)}</strong></div>`).join('') : '<p style="color:var(--muted)">Add items to your cart to see the summary.</p>';
      document.getElementById('checkoutAmount').textContent = `$${total.toFixed(2)}`;
    }
    function removeCartItem(productId) {
      delete appState.cart[productId];
      saveLocalData();
      updateCartPanel();
      showToast('Product removed from cart');
    }
    function viewProduct(id) {
      const product = appState.products.find(item => item.id === id);
      if (!product) return;
      const popup = window.open('', '_blank', 'width=800,height=700');
      popup.document.write(`<html><head><title>${product.title}</title><style>body{font-family:Inter,sans-serif;padding:24px;background:#f3f4f6;color:#111;}img{max-width:100%;border-radius:20px;}button{padding:12px 18px;border:none;border-radius:12px;background:#1f3d8f;color:#fff;cursor:pointer;}</style></head><body><h1>${product.title}</h1><img src="${product.image}" alt="${product.title}"><p>${product.description}</p><p><strong>Category:</strong> ${product.category}</p><p><strong>Price:</strong> $${product.price.toFixed(2)}</p><p><strong>Stock:</strong> ${product.stock}</p><button onclick="window.close()">Close</button></body></html>`);
    }
    function adminLogin() {
      const username = document.getElementById('adminUsername').value.trim();
      const password = document.getElementById('adminPassword').value.trim();
      if (username === 'admin' && password === passwordHash) {
        appState.adminLoggedIn = true;
        localStorage.setItem(STORAGE_KEYS.admin, 'true');
        renderAdmin();
        showToast('Admin login successful');
      } else {
        showToast('Invalid credentials');
      }
    }
    function adminLogout() {
      appState.adminLoggedIn = false;
      localStorage.removeItem(STORAGE_KEYS.admin);
      renderAdmin();
      showToast('Logged out');
    }
    function renderAdmin() {
      const loginCard = document.getElementById('adminLoginCard');
      const dashboard = document.getElementById('adminDashboard');
      if (!appState.adminLoggedIn) {
        loginCard.classList.remove('hidden');
        dashboard.classList.add('hidden');
        return;
      }
      loginCard.classList.add('hidden');
      dashboard.classList.remove('hidden');
      const tabs = [
        { id: 'products', title: 'Products' },
        { id: 'orders', title: 'Orders' },
        { id: 'settings', title: 'Store settings' }
      ];
      document.getElementById('adminTabs').innerHTML = tabs.map(tab => `<div class="admin-tab ${appState.activeAdminTab === tab.id ? 'active' : ''}" onclick="setAdminTab('${tab.id}')">${tab.title}</div>`).join('');
      renderAdminSection();
    }
    function setAdminTab(tab) {
      appState.activeAdminTab = tab;
      renderAdmin();
    }
    function renderAdminSection() {
      const container = document.getElementById('adminSections');
      if (appState.activeAdminTab === 'products') {
        container.innerHTML = adminProductsTemplate();
      } else if (appState.activeAdminTab === 'orders') {
        container.innerHTML = adminOrdersTemplate();
      } else if (appState.activeAdminTab === 'settings') {
        container.innerHTML = adminSettingsTemplate();
      }
    }
    function adminProductsTemplate() {
      return `<div class="admin-card"><h3>Manage products</h3><div class="admin-actions"><button onclick="openProductForm()">Add product</button><button onclick="renderProducts()">Refresh store</button></div></div>
        <div class="admin-card"><table class="table"><thead><tr><th>Product</th><th>Category</th><th>Price</th><th>Stock</th><th>Actions</th></tr></thead><tbody>${appState.products.map(product => `<tr><td>${product.title}</td><td>${product.category}</td><td>$${product.price.toFixed(2)}</td><td>${product.stock}</td><td><button onclick="openProductForm('${product.id}')">Edit</button><button onclick="deleteProduct('${product.id}')" style="background: rgba(239,68,68,.16); color: #b91c1c;">Delete</button></td></tr>`).join('')}</tbody></table></div>`;
    }
    function adminOrdersTemplate() {
      return `<div class="admin-card"><h3>Customer orders</h3>${appState.orders.length ? `<table class="table"><thead><tr><th>Order ID</th><th>Customer</th><th>Amount</th><th>Status</th><th>Date</th></tr></thead><tbody>${appState.orders.map(order => `<tr><td>${order.id}</td><td>${order.name}</td><td>$${order.total.toFixed(2)}</td><td>${order.status}</td><td>${new Date(order.created).toLocaleString()}</td></tr>`).join('')}</tbody></table>` : '<p style="color:var(--muted)">No orders received yet.</p>'}</div>`;
    }
    function adminSettingsTemplate() {
      const settings = appState.settings;
      return `<div class="admin-card"><h3>Store appearance and info</h3><div class="form-grid"><div class="form-row"><label>Logo text</label><input id="settingLogo" value="${settings.logoText}" /></div><div class="form-row"><label>Primary color</label><input id="settingPrimary" type="color" value="${settings.primaryColor}" /></div><div class="form-row"><label>Secondary color</label><input id="settingSecondary" type="color" value="${settings.secondaryColor}" /></div><div class="form-row" style="grid-column:1/-1"><label>Support email</label><input id="settingEmail" value="${settings.contactEmail}" /></div><div class="form-row"><label>Support phone</label><input id="settingPhone" value="${settings.contactPhone}" /></div><div class="form-row" style="grid-column:1/-1"><label>Hero text</label><textarea id="settingHero" rows="4">${settings.heroBanner}</textarea></div><button onclick="saveSettings()">Save settings</button></div></div>`;
    }
    function openProductForm(productId) {
      const product = appState.products.find(item => item.id === productId) || { id:'', title:'', category:'', price:'', description:'', stock:'', image:'', rating:4.5, new:true, bestSeller:false };
      const formHtml = `<div class="admin-card"><h3>${product.id ? 'Edit product' : 'Add product'}</h3><div class="form-grid"><div class="form-row"><label>Title</label><input id="formTitle" value="${product.title}" /></div><div class="form-row"><label>Category</label><input id="formCategory" value="${product.category}" /></div><div class="form-row"><label>Price</label><input id="formPrice" type="number" value="${product.price}" /></div><div class="form-row"><label>Stock</label><input id="formStock" type="number" value="${product.stock}" /></div><div class="form-row" style="grid-column:1/-1"><label>Description</label><textarea id="formDescription" rows="4">${product.description}</textarea></div><div class="form-row"><label>Image URL</label><input id="formImage" value="${product.image}" /></div><div class="form-row"><label>Upload image</label><input id="formImageFile" type="file" accept="image/*" onchange="previewUpload(this)" /></div><div class="form-row"><label>Rating</label><input id="formRating" type="number" min="0" max="5" step="0.1" value="${product.rating}" /></div><div class="form-row"><label>Best seller</label><select id="formBestSeller"><option value="true" ${product.bestSeller ? 'selected' : ''}>Yes</option><option value="false" ${!product.bestSeller ? 'selected' : ''}>No</option></select></div><div class="form-row"><label>New product</label><select id="formNew"><option value="true" ${product.new ? 'selected' : ''}>Yes</option><option value="false" ${!product.new ? 'selected' : ''}>No</option></select></div><button onclick="saveProduct('${product.id}')">Save product</button><button onclick="renderAdmin()" style="background:#64748b">Cancel</button></div></div>`;
      document.getElementById('adminSections').innerHTML = formHtml;
    }
    function previewUpload(input) {
      const file = input.files && input.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = () => document.getElementById('formImage').value = reader.result;
      reader.readAsDataURL(file);
    }
    function saveProduct(existingId) {
      const title = document.getElementById('formTitle').value.trim();
      const category = document.getElementById('formCategory').value.trim();
      const price = Number(document.getElementById('formPrice').value);
      const stock = Number(document.getElementById('formStock').value);
      const description = document.getElementById('formDescription').value.trim();
      const image = document.getElementById('formImage').value.trim();
      const rating = Number(document.getElementById('formRating').value);
      const bestSeller = document.getElementById('formBestSeller').value === 'true';
      const isNew = document.getElementById('formNew').value === 'true';
      if (!title || !category || !price || !stock || !description || !image) {
        showToast('Complete all product fields');
        return;
      }
      const productData = { id: existingId || `p${Date.now()}`, title, category, price, stock, description, image, rating, bestSeller, new: isNew };
      if (existingId) {
        const index = appState.products.findIndex(item => item.id === existingId);
        appState.products[index] = productData;
      } else {
        appState.products.unshift(productData);
      }
      saveLocalData();
      renderProducts();
      renderAdmin();
      showToast('Product saved successfully');
    }
    function deleteProduct(productId) {
      appState.products = appState.products.filter(item => item.id !== productId);
      saveLocalData();
      renderProducts();
      renderAdmin();
      showToast('Product removed');
    }
    function saveSettings() {
      appState.settings.logoText = document.getElementById('settingLogo').value.trim();
      appState.settings.primaryColor = document.getElementById('settingPrimary').value;
      appState.settings.secondaryColor = document.getElementById('settingSecondary').value;
      appState.settings.contactEmail = document.getElementById('settingEmail').value.trim();
      appState.settings.contactPhone = document.getElementById('settingPhone').value.trim();
      appState.settings.heroBanner = document.getElementById('settingHero').value.trim();
      document.documentElement.style.setProperty('--primary', appState.settings.primaryColor);
      document.documentElement.style.setProperty('--secondary', appState.settings.secondaryColor);
      saveLocalData();
      renderProducts();
      showToast('Store settings updated');
    }
    function sendContact() {
      const name = document.getElementById('contactName').value.trim();
      const email = document.getElementById('contactEmail').value.trim();
      const message = document.getElementById('contactMessage').value.trim();
      if (!name || !email || !message) {
        showToast('Please fill in all contact fields');
        return;
      }
      document.getElementById('contactName').value = '';
      document.getElementById('contactEmail').value = '';
      document.getElementById('contactMessage').value = '';
      showToast('Thank you! We will respond shortly');
    }
    function completeCheckout() {
      const name = document.getElementById('checkoutName').value.trim();
      const email = document.getElementById('checkoutEmail').value.trim();
      const address = document.getElementById('checkoutAddress').value.trim();
      const city = document.getElementById('checkoutCity').value.trim();
      const postal = document.getElementById('checkoutPostal').value.trim();
      if (!name || !email || !address || !city || !postal) {
        showToast('Complete billing details to proceed');
        return;
      }
      const cartItems = Object.keys(appState.cart).map(id => {
        const product = appState.products.find(item => item.id === id);
        return { product, qty: appState.cart[id] };
      });
      if (!cartItems.length) {
        showToast('Your cart is empty');
        return;
      }
      const total = cartItems.reduce((sum, item) => sum + item.product.price * item.qty, 0);
      appState.orders.unshift({ id: `ORD-${Date.now()}`, name, email, address, city, postal, total, status: 'Awaiting fulfillment', created: Date.now(), items: cartItems });
      appState.cart = {};
      saveLocalData();
      renderProducts();
      updateCartPanel();
      showToast('Order completed successfully');
      navigate('home');
    }
    function toggleTheme() {
      const isDark = !document.documentElement.classList.contains('dark');
      document.documentElement.classList.toggle('dark', isDark);
      document.getElementById('themeToggle').textContent = isDark ? 'Light mode' : 'Dark mode';
      localStorage.setItem(STORAGE_KEYS.theme, isDark ? 'dark' : 'light');
    }
    function init() {
      loadLocalData();
      renderProducts();
      renderAdmin();
      updateCartPanel();
      document.getElementById('loader').classList.add('hide');
      setTimeout(() => document.getElementById('loader').remove(), 600);
    }
    window.addEventListener('DOMContentLoaded', init);
  </script>
</body>
</html>
