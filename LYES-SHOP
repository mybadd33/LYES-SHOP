        <div class="cards-row">
          <div class="panel checkout-card">
            <h3>Billing details</h3>
            <input id="checkoutName" placeholder="Full name" />
            <input id="checkoutEmail" type="email" placeholder="Email address" />
            <input id="checkoutAddress" placeholder="Shipping address" />
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;"><input id="checkoutCity" placeholder="City" /><input id="checkoutPostal" placeholder="Postal code" /></div>
            <select id="checkoutPayment">
              <option value="card">Credit/Debit card</option>
              <option value="paypal">PayPal</option>
              <option value="bank">Bank transfer</option>
            </select>
            <button onclick="completeCheckout()">Complete purchase</button>
          </div>
          <div class="panel">
            <h3>Your order</h3>
            <div id="checkoutSummary"></div>
            <div style="margin-top:16px; font-weight:700;">Total <span id="checkoutAmount">$0</span></div>
          </div>
        </div>
      </section>
      <section id="adminPage" class="hidden">
        <div id="adminLoginCard" class="admin-card">
          <div class="section-title"><h2>Admin login</h2></div>
          <p>Secure access for store management. Username: <strong>admin</strong>, password: <strong>LYES2026</strong></p>
          <div class="form-grid">
            <div class="form-row"><label>Username</label><input id="adminUsername" placeholder="Admin username" /></div>
            <div class="form-row"><label>Password</label><input id="adminPassword" type="password" placeholder="Admin password" /></div>
