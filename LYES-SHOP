<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>LYES SHOP - Premium E-Commerce Experience</title>
  <style>
    :root {
      --bg: #f7f8fb;
      --surface: #ffffff;
      --primary: #1f3d8f;
      --secondary: #2d9cdb;
      --text: #1f2937;
      --muted: #64748b;
      --danger: #ef4444;
      --success: #22c55e;
      --border: rgba(148, 163, 184, 0.2);
      --shadow: 0 20px 45px rgba(15, 23, 42, 0.08);
      --radius: 24px;
    }
    .dark {
      --bg: #0f172a;
      --surface: #111827;
      --primary: #60a5fa;
      --secondary: #38bdf8;
      --text: #e2e8f0;
      --muted: #94a3b8;
      --border: rgba(148, 163, 184, 0.16);
      --shadow: 0 20px 45px rgba(3, 7, 18, 0.55);
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
      background: radial-gradient(circle at top left, rgba(45, 156, 219, 0.14), transparent 25%), var(--bg);
      color: var(--text);
    }
    img { max-width: 100%; display: block; }
    button, input, textarea, select { font: inherit; }
    .hidden { display: none !important; }
    .loader-screen {
      position: fixed; inset: 0; z-index: 9999;
      display: flex; align-items: center; justify-content: center;
      background: var(--bg);
      transition: opacity .4s ease;
    }
    .loader-screen.hide { opacity: 0; pointer-events: none; }
    .loader-dot {
      width: 16px; height: 16px; margin: 0 6px; border-radius: 50%;
      background: var(--primary); animation: bounce 0.8s infinite ease-in-out;
    }
    .loader-dot:nth-child(2) { animation-delay: 0.15s; }
    .loader-dot:nth-child(3) { animation-delay: 0.3s; }
    @keyframes bounce {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-16px); }
    }
    .toast {
      position: fixed; right: 20px; top: 20px; z-index: 10000;
      padding: 14px 18px; border-radius: 14px; background: rgba(15,23,42,.94);
      color: #f8fafc; box-shadow: var(--shadow); opacity: 0; transform: translateY(-10px);
      transition: opacity .3s ease, transform .3s ease;
      pointer-events: none;
    }
    .toast.show { opacity: 1; transform: translateY(0); }
    .app-shell { display: flex; min-height: 100vh; }
    .sidebar {
      width: 280px; background: rgba(255,255,255,.92); border-right: 1px solid var(--border);
      padding: 28px 24px; display: flex; flex-direction: column; gap: 18px;
      position: sticky; top: 0; height: 100vh;
    }
    .sidebar h1 { font-size: 1.35rem; margin: 0; letter-spacing: -0.02em; }
    .sidebar p { margin: 0; color: var(--muted); }
    .nav-link, .tab-button { display: flex; align-items: center; justify-content: space-between; gap: 10px; text-decoration: none; color: var(--text); padding: 14px 16px; border-radius: 16px; transition: background .2s ease, transform .2s ease; }
    .nav-link:hover, .tab-button:hover { background: rgba(56, 189, 248, .12); transform: translateX(2px); }
    .nav-link.active { background: rgba(56, 189, 248, .18); }
    .section-title { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin: 0 0 18px; }
    .section-title h2 { margin: 0; font-size: 1.25rem; }
    .button, button {
      border: none; cursor: pointer; border-radius: 999px; padding: 12px 22px;
      background: var(--primary); color: white; box-shadow: var(--shadow); transition: transform .2s ease, background .2s ease;
    }
    .button:hover, button:hover { transform: translateY(-1px); background: var(--secondary); }
    .hero { padding: 44px 0 20px; }
    .hero-grid { display: grid; grid-template-columns: 1.1fr .9fr; gap: 28px; align-items: center; }
    .hero-card { background: var(--surface); padding: 32px; border-radius: var(--radius); box-shadow: var(--shadow); }
    .hero-card h1 { margin: 0 0 16px; font-size: clamp(2rem, 4vw, 3.6rem); line-height: 1.05; }
    .hero-card p { margin: 0 0 24px; color: var(--muted); max-width: 520px; }
    .hero-stats { display: flex; gap: 16px; flex-wrap: wrap; }
    .hero-stat { background: rgba(56,189,248,.1); border: 1px solid rgba(56,189,248,.18); padding: 18px 20px; border-radius: 18px; min-width: 150px; }
    .hero-stat strong { display: block; font-size: 1.1rem; margin-bottom: 4px; }
    .banner-panel { display: grid; gap: 18px; margin-top: 20px; }
    .banner-large { background: linear-gradient(135deg, var(--primary), var(--secondary)); color: white; border-radius: var(--radius); min-height: 260px; display: grid; place-items: center; padding: 32px; }
    .banner-large h3 { margin: 0 0 12px; font-size: 1.75rem; }
    .banner-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18px; }
    .card-list { display: grid; gap: 20px; }
    .product-card {
      background: var(--surface); border-radius: 28px; padding: 18px; box-shadow: var(--shadow); transition: transform .2s ease;
    }
    .product-card:hover { transform: translateY(-4px); }
    .product-card img { border-radius: 22px; width: 100%; object-fit: cover; aspect-ratio: 4 / 3; }
    .product-card h3 { margin: 14px 0 8px; font-size: 1.1rem; }
    .product-card p { margin: 0; color: var(--muted); font-size: 0.96rem; }
    .product-price { margin-top: 12px; display: flex; justify-content: space-between; align-items: center; gap: 12px; }
    .rating { display: inline-flex; align-items: center; gap: 6px; color: #f59e0b; font-size: 0.95rem; }
    .category-pill { display: inline-flex; gap: 6px; padding: 8px 12px; border-radius: 999px; background: rgba(56,189,248,.12); color: var(--primary); font-size: 0.84rem; }
    .grid-3 { display: grid; gap: 20px; grid-template-columns: repeat(3,minmax(0,1fr)); }
    .grid-2 { display: grid; gap: 20px; grid-template-columns: repeat(2,minmax(0,1fr)); }
    .topbar {
      width: 100%; padding: 20px 24px; display: flex; align-items: center; justify-content: space-between;
      background: rgba(255,255,255,.92); position: sticky; top: 0; z-index: 50; border-bottom: 1px solid var(--border);
    }
    .topbar h2 { margin: 0; font-size: 1.1rem; }
    .topbar-actions { display: flex; gap: 12px; align-items: center; }
    .topbar-actions button { background: rgba(31, 61, 143, 0.08); color: var(--text); padding: 11px 16px; border-radius: 999px; }
    .topbar-actions button:hover { background: rgba(31, 61, 143, 0.14); }
    .search-bar { background: var(--surface); padding: 18px 20px; border-radius: 22px; display: flex; gap: 14px; align-items: center; box-shadow: var(--shadow); }
    .search-bar input {
      border: 1px solid var(--border); padding: 14px 16px; border-radius: 16px; width: 100%; background: transparent;
    }
    .search-bar button { background: var(--primary); }
    .cards-row { display: grid; grid-template-columns: 1.4fr .6fr; gap: 24px; }
    .panel { background: var(--surface); border-radius: 28px; padding: 24px; box-shadow: var(--shadow); }
    .panel h3 { margin: 0 0 16px; }
    .panel .panel-item { display: flex; justify-content: space-between; align-items: center; padding: 14px 0; border-bottom: 1px solid var(--border); }
    .panel .panel-item:last-child { border-bottom: none; }
    .panel .panel-item strong { color: var(--text); }
    .cart-list { display: grid; gap: 18px; }
    .cart-item { display: grid; grid-template-columns: 88px 1fr; gap: 18px; align-items: center; }
    .cart-item img { border-radius: 20px; width: 100%; height: 88px; object-fit: cover; }
    .cart-item-details { display: grid; gap: 6px; }
    .cart-item-details button { background: transparent; color: var(--danger); padding: 0; box-shadow: none; }
    .checkout-card { display: grid; gap: 14px; }
    .checkout-card input, .checkout-card textarea, .checkout-card select {
      width: 100%; border: 1px solid var(--border); border-radius: 16px; padding: 14px 16px; background: transparent; color: var(--text);
    }
    .footer { padding: 40px 24px; display: grid; gap: 24px; background: rgba(15, 23, 42, 0.05); margin-top: 28px; }
    .footer-grid { display: grid; grid-template-columns: repeat(4, minmax(0,1fr)); gap: 24px; }
    .footer h4 { margin: 0 0 14px; }
    .footer a { color: var(--text); text-decoration: none; display: block; margin: 8px 0; }
    .badge { display: inline-flex; align-items: center; gap: 8px; padding: 8px 12px; border-radius: 999px; background: rgba(34,197,94,.12); color: var(--success); font-size: 0.84rem; }
    .alert { display: inline-flex; padding: 10px 14px; border-radius: 16px; background: rgba(15,23,42,.06); color: var(--text); }
    .admin-panel { display: grid; gap: 24px; }
    .admin-tabs { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-bottom: 12px; }
    .admin-tab { border: 1px solid var(--border); background: var(--surface); padding: 14px 16px; border-radius: 16px; cursor: pointer; text-align: center; }
    .admin-tab.active { border-color: var(--primary); color: var(--primary); background: rgba(56,189,248,.12); }
    .form-grid { display: grid; gap: 18px; }
    .form-row { display: grid; gap: 14px; }
    .form-row label { font-size: 0.95rem; color: var(--muted); }
    .form-row input, .form-row textarea, .form-row select { width: 100%; border: 1px solid var(--border); border-radius: 16px; padding: 14px 16px; background: transparent; color: var(--text); }
    .status-pill { display: inline-flex; align-items: center; justify-content: center; padding: 8px 14px; border-radius: 999px; font-size: 0.85rem; background: rgba(34,197,94,0.14); color: #166534; }
    .table { width: 100%; border-collapse: collapse; }
    .table th, .table td { text-align: left; padding: 14px 12px; border-bottom: 1px solid var(--border); }
    .table th { color: var(--muted); font-weight: 600; }
    .admin-card { background: var(--surface); padding: 20px; border-radius: 24px; box-shadow: var(--shadow); }
    .admin-row { display: grid; gap: 18px; grid-template-columns: repeat(2,minmax(0,1fr)); }
    .admin-actions { display: flex; flex-wrap: wrap; gap: 12px; }
    .settings-grid { display: grid; gap: 18px; }
    .profile-banner { display: grid; gap: 10px; }
    .profile-banner input { width: auto; }
    .hero-image-block { position: relative; border-radius: var(--radius); overflow: hidden; min-height: 380px; display: grid; place-items: center; }
    .hero-image-block:before {
      content: "";
      position: absolute; inset: 0;
      background: radial-gradient(circle at 20% 20%, rgba(56,189,248,.18), transparent 24%), radial-gradient(circle at 80% 20%, rgba(99,102,241,.18), transparent 24%);
    }
    .hero-image-block img { position: relative; z-index: 1; width: 100%; height: 100%; object-fit: cover; }
    .category-grid { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 18px; }
    .category-card { display: flex; flex-direction: column; gap: 12px; padding: 22px; border-radius: 24px; background: var(--surface); box-shadow: var(--shadow); min-height: 180px; }
    .category-card h3 { margin: 0; }
    .footer .social-links { display: flex; gap: 12px; align-items: center; }
    .social-link { width: 44px; height: 44px; display: grid; place-items: center; background: rgba(56,189,248,.12); border-radius: 14px; color: var(--primary); text-decoration: none; }
    .form-grid .row { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
    .hero-grid, .cards-row, .footer-grid, .category-grid, .grid-3, .grid-2, .admin-row { transition: all .2s ease; }
    .product-actions { display: flex; gap: 10px; flex-wrap: wrap; }
    .pill { display: inline-flex; gap: 8px; padding: 8px 12px; border-radius: 999px; background: rgba(59,130,246,.12); color: var(--primary); font-size: 0.83rem; }
    .notification-bar { position: fixed; top: 84px; left: 50%; transform: translateX(-50%); background: rgba(15,23,42,.92); color: white; padding: 12px 18px; border-radius: 16px; display: none; z-index: 1000; }
    .notification-bar.active { display: block; }
    @media (max-width: 1080px) {
      .app-shell { flex-direction: column; }
      .sidebar { width: 100%; height: auto; position: relative; }
      .hero-grid, .cards-row, .footer-grid, .category-grid, .grid-3, .grid-2, .admin-row { grid-template-columns: 1fr; }
      .cards-row { gap: 18px; }
      .hero-card { padding: 28px; }
      .banner-grid { grid-template-columns: 1fr; }
    }
    @media (max-width: 720px) {
      .topbar, .sidebar { padding: 16px; }
      .sidebar { border-right: none; border-bottom: 1px solid var(--border); }
      .hero-card, .banner-large, .product-card, .panel, .admin-card { border-radius: 20px; }
      .search-bar { flex-direction: column; align-items: stretch; }
      .topbar-actions { flex-wrap: wrap; }
      .admin-tabs { grid-template-columns: 1fr; }
      .footer-grid { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>
  <div id="loader" class="loader-screen">
    <div class="loader-dot"></div>
    <div class="loader-dot"></div>
    <div class="loader-dot"></div>
  </div>
  <div id="toast" class="toast"></div>
  <div class="topbar">
    <div>
      <strong>LYES SHOP</strong>
      <span style="margin-left:12px;color:var(--muted);">Premium commerce experience</span>
    </div>
    <div class="topbar-actions">
      <button onclick="navigate('home')">Home</button>
      <button onclick="navigate('contact')">Contact</button>
      <button onclick="navigate('admin')">Admin</button>
      <button id="themeToggle" onclick="toggleTheme()">Dark mode</button>
    </div>
  </div>
  <div class="app-shell">
    <aside class="sidebar">
      <h1>LYES SHOP</h1>
      <p>Modern online store interface for customers and administrator.</p>
      <a class="nav-link active" href="javascript:navigate('home')">Explore store</a>
      <a class="nav-link" href="javascript:navigate('shop')">Products</a>
      <a class="nav-link" href="javascript:navigate('categories')">Categories</a>
      <a class="nav-link" href="javascript:navigate('contact')">Contact</a>
      <a class="nav-link" href="javascript:navigate('admin')">Admin login</a>
      <div class="section-title"><h2>Quick info</h2></div>
      <div class="alert">Secure admin panel with local configuration in one file.</div>
      <div class="alert">Cart and checkout ready for easy upgrade.</div>
    </aside>
    <main id="mainContent" style="flex:1; padding: 28px;">
      <section id="homePage">
        <div class="hero">
          <div class="hero-grid">
            <div class="hero-card">
              <p class="badge">Most trusted online destination</p>
              <h1>Visit LYES SHOP for elegant, premium products with a smooth shopping experience.</h1>
              <p>Shop top trends, explore new arrivals, and complete secure checkout with a fast responsive interface built for modern businesses.</p>
              <div class="hero-stats">
                <div class="hero-stat"><strong>300+</strong> products available</div>
                <div class="hero-stat"><strong>4.9/5</strong> average rating</div>
                <div class="hero-stat"><strong>99%</strong> happy customer rate</div>
              </div>
            </div>
            <div class="hero-image-block">
              <img src="https://images.unsplash.com/photo-1512436991641-6745cdb1723f?auto=format&fit=crop&w=900&q=80" alt="LYES SHOP featured" />
            </div>
          </div>
        </div>
        <div class="search-bar" style="margin-top: 28px;">
          <input id="searchInput" type="search" placeholder="Search new arrivals, categories, brands..." oninput="renderProducts()" />
          <button onclick="renderProducts()">Search</button>
        </div>
        <div class="section-title" style="margin-top: 28px;">
          <h2>New products</h2>
          <span style="color: var(--muted);">Fresh drops curated for your store.</span>
        </div>
        <div id="productsGrid" class="grid-3"></div>
        <div class="section-title" style="margin-top: 40px;">
          <h2>Best sellers</h2>
          <span style="color: var(--muted);">Customer favorites and top-rated items.</span>
        </div>
        <div id="bestSellersGrid" class="grid-3"></div>
        <div class="section-title" style="margin-top: 40px;">
          <h2>Shop by category</h2>
          <span style="color: var(--muted);">Organized browsing for easy discovery.</span>
        </div>
        <div class="category-grid" id="categoryGrid"></div>
        <div class="cards-row" style="margin-top: 40px;">
          <div class="panel">
            <h3>Shopping cart</h3>
            <div id="cartList" class="cart-list"></div>
            <div class="admin-actions" style="justify-content: space-between; padding-top: 16px;">
              <strong id="cartTotal">Total: $0</strong>
              <button onclick="navigate('checkout')">Proceed to Checkout</button>
            </div>
          </div>
          <div class="panel">
            <h3>Featured categories</h3>
            <div class="pill">Newest arrivals</div>
            <div class="pill">Premium electronics</div>
            <div class="pill">Fast shipping</div>
            <div class="pill">Verified sellers</div>
          </div>
        </div>
      </section>
      <section id="shopPage" class="hidden">
        <div class="section-title"><h2>Product catalog</h2></div>
        <div class="grid-3" id="productList"></div>
      </section>
      <section id="categoriesPage" class="hidden">
        <div class="section-title"><h2>Categories</h2></div>
        <div class="category-grid" id="categoryList"></div>
      </section>
      <section id="contactPage" class="hidden">
        <div class="section-title"><h2>Contact & support</h2></div>
        <div class="cards-row">
          <div class="panel">
            <h3>Send us a message</h3>
            <div class="form-grid">
              <div class="form-row"><label>Name</label><input id="contactName" placeholder="Your name" /></div>
              <div class="form-row"><label>Email</label><input id="contactEmail" type="email" placeholder="you@example.com" /></div>
              <div class="form-row" style="grid-column: 1 / -1;"><label>Message</label><textarea id="contactMessage" rows="6" placeholder="How can we help you?"></textarea></div>
              <button onclick="sendContact()">Send message</button>
