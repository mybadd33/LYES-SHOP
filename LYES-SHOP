      <div>
        <h4>Support</h4>
        <a href="mailto:support@lyesshop.com">support@lyesshop.com</a>
        <a href="javascript:navigate('admin')">Admin login</a>
      </div>
      <div>
        <h4>Follow us</h4>
        <div class="social-links"><a class="social-link" href="#">F</a><a class="social-link" href="#">I</a><a class="social-link" href="#">T</a></div>
      </div>
    </div>
